# Copy this file to .env and adjust if needed. .env itself is gitignored.

OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
DOCS_DIR=documents
CHROMA_DIR=chroma_db
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4

# Reranking: fetch FETCH_K chunks by vector search, rerank with a cross-encoder, keep TOP_K.
# Set RERANK=false to get the original (baseline) behaviour.
RERANK=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
FETCH_K=20
